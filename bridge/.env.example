# Copy to bridge/.env and fill in. Never commit bridge/.env.
# Values already set in the shell environment win over this file.
#
# This file is read by EVERY Claude Code session that loads the bridge, from any
# project, because it sits next to server.ts. Put only machine-wide values here.
# Per-project settings (CLAUDE_WALK_PORT, CLAUDE_WALK_PROJECT) belong in that
# project's .mcp.json "env" block instead.

# Shared secret the phone presents when it connects. Generate one with:
#   bun -e "console.log(require('crypto').randomBytes(16).toString('base64url'))"
# If unset, the bridge makes a new token on every launch and logs it to stderr,
# so the phone would need the new token each time.
CLAUDE_WALK_TOKEN=
